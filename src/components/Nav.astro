---
const { title } = Astro.props as { title?: string };
---

<header class="border-b border-zinc-800 bg-black/60 backdrop-blur">
	<div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
		<a href="/" class="font-anton text-xl uppercase tracking-widest text-white">
			Posgrado<span class="text-zinc-500"> UNSAAC</span>
		</a>
		{title && <span class="text-sm text-zinc-400">{title}</span>}
	</div>
</header>
