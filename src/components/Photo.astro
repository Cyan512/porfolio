---
import { getImage, Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import placeholderImg from "@/assets/images/placeholder.png";

export interface PhotoProps {
  src?: string | ImageMetadata | null;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
  sizes?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
}

const { src, alt, class: className, width, height, sizes, loading = "lazy", fetchpriority } =
	Astro.props as PhotoProps;

const placeholderUrl = (await getImage({ src: placeholderImg, width: 800, height: 400 })).src;
---

{typeof src === "string" ? (
	<img
		src={src}
		alt={alt}
		class={className}
		width={width}
		height={height}
		loading={loading}
		fetchpriority={fetchpriority}
		onerror={`this.onerror=null;this.src='${placeholderUrl}'`}
	/>
) : (
	<Image
		src={src ?? placeholderImg}
		alt={alt}
		class={className}
		width={width}
		height={height}
		sizes={sizes}
		loading={loading}
		fetchpriority={fetchpriority}
	/>
)}
