---
import Icon from "@/components/Icon.astro";
import type { ProgramaListItem } from "@/types";

const { programa } = Astro.props as { programa: ProgramaListItem };

const formatSoles = (valor: number | null | undefined) =>
	new Intl.NumberFormat("es-PE", { style: "currency", currency: "PEN" }).format(valor ?? 0);
---

<a
	href={`/${programa.tipoPrograma?.slug ?? ""}/${programa.slug}`}
	class="group flex flex-col overflow-hidden rounded-2xl bg-zinc-900 border border-zinc-800 hover:border-zinc-600 transition-colors"
>
	<img
		src={programa.imagen ?? "/images/placeholder.png"}
		alt={programa.nombre}
		class="h-44 w-full object-cover opacity-70 transition-opacity group-hover:opacity-90"
		loading="lazy"
	/>
	<div class="flex flex-1 flex-col gap-3 p-5">
		<h3 class="text-lg font-semibold leading-snug text-white">{programa.nombre}</h3>
		<p class="line-clamp-2 text-sm text-zinc-400">{programa.objetivoGeneral}</p>
		<div class="mt-auto flex flex-wrap items-center gap-2 pt-2 text-xs text-zinc-400">
			{programa.modalidad?.nombre && (
				<span class="rounded-full bg-zinc-800 px-3 py-1">{programa.modalidad.nombre}</span>
			)}
			{programa.facultad?.nombre && (
				<span class="rounded-full bg-zinc-800 px-3 py-1">{programa.facultad.nombre}</span>
			)}
		</div>
		<div class="flex items-center justify-between pt-2">
			<span class="text-sm font-semibold text-white">
				{formatSoles(programa.costoMatricula)}
				<span class="font-normal text-zinc-500">/ matrícula</span>
			</span>
			<span class="text-zinc-500 transition-transform group-hover:translate-x-1 group-hover:text-white">
				<Icon name="arrow-right" />
			</span>
		</div>
	</div>
</a>
