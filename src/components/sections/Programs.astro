---
import { obtenerTiposPrograma } from "@/lib/api/tipos-programa";
const tiposPrograma = await obtenerTiposPrograma();
const placeholder = "/images/placeholder.png";
---

<section class="relative w-full py-16 sm:py-20 lg:py-28">
    <div class="container relative z-10 mx-auto w-full px-4 sm:px-6 lg:px-8">
        <div class="mb-10 lg:mb-14">
            <div>
                <h2
                    class="text-primary text-3xl font-semibold leading-tight tracking-tight sm:text-4xl lg:text-5xl"
                >
                    Conoce Nuestros Programas
                </h2>
            </div>
        </div>
        <div class="flex items-center gap-6 h-100 w-full mt-10 mx-auto">
            {
                tiposPrograma.map((tipo) => (
                    <a
                        href={`${tipo.slug}`}
                        class="relative group grow transition-all w-56 h-100 duration-500 hover:w-full"
                    >
                        <img
                            src={tipo.imagenCard ?? placeholder}
                            alt={tipo.nombre}
                            onerror={`this.onerror = null; this.src = '${placeholder}'`}
                            class="h-full w-full object-cover object-center"
                        />
                        <div class="absolute inset-0 flex flex-col justify-end p-10 text-white bg-black/50 opacity-0 group-hover:opacity-100 transition-all duration-300">
                            <h1 class="text-3xl">{tipo.nombre}</h1>
                            <p class="text-sm">{tipo.slug}</p>
                        </div>
                    </a>
                ))
            }
        </div>
    </div>
</section>
