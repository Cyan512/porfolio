---
import { obtenerTiposPrograma } from "@/lib/api/tipos-programa";
const tiposPrograma = await obtenerTiposPrograma();
---

<section class="relative w-full overflow-hidden">
    <div
        class="relative z-10 container mx-auto w-full px-4 sm:px-6 lg:px-8 py-16 sm:py-20 lg:py-28"
    >
        <div class="grid grid-cols-2 lg:grid-cols-4">
            {
                tiposPrograma.map((tipo, index) => (
                    <div
                        class:list={[
                            "flex flex-col items-center justify-center px-5 py-12 text-center sm:py-14 lg:min-h-80 lg:px-8 lg:py-16",
                            {
                                "border-l border-white/20": index !== 0 && index !== 2,
                                "lg:border-l border-white/20": index === 2,
                                "border-t border-white/20 lg:border-t-0": index >= 2,
                            },
                        ]}
                    >
                        <span class="mt-4 text-4xl font-bold leading-none tracking-tight text-white sm:text-5xl lg:text-6xl">
                            1
                        </span>
                        <h2 class="mt-3 max-w-52 text-lg font-semibold uppercase leading-tight text-white sm:text-xl lg:text-2xl">
                            {tipo.nombre}
                        </h2>
                    </div>
                ))
            }
        </div>
    </div>
</section>
