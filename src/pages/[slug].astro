---
import Nav from "@/components/Nav.astro";
import ProgramaCard from "@/components/ProgramaCard.astro";
import { getProgramasByTipo, getTiposPrograma } from "@/lib/api";
import Layout from "@/layouts/Layout.astro";
import type { PagedData, ProgramaListItem, TipoPrograma } from "@/types";

export const prerender = true;

const { slug } = Astro.params as { slug: string };
const tipos = await getTiposPrograma();
const tipo = tipos.find((t) => t.slug === slug);

let inicial: PagedData<ProgramaListItem>;
try {
  inicial = await getProgramasByTipo(slug, { page: 0, size: 10 });
} catch {
  Astro.response.status = 404;
  inicial = { content: [], page: { size: 10, number: 0, totalElements: 0, totalPages: 0 } };
}

export async function getStaticPaths() {
  const tipos = await getTiposPrograma();
  return tipos.map(({ slug }) => ({ params: { slug } }));
}
---

<Layout>
	<Nav title={tipo?.nombre} />
	<main class="mx-auto max-w-6xl px-4 py-12" id="app" data-slug={slug}>
		{tipo ? (
		<header class="flex flex-wrap items-end justify-between gap-4">
			<div>
				<h1 class="font-anton text-3xl uppercase tracking-wide text-white sm:text-5xl">
					{tipo?.nombre}
				</h1>
				<p class="mt-2 text-sm text-zinc-400" id="total">
					{inicial.page.totalElements} programas
				</p>
			</div>
			<label class="relative block">
				<span class="sr-only">Buscar programa</span>
				<input
					id="search"
					type="search"
					placeholder="Buscar programa…"
					class="w-64 rounded-full border border-zinc-700 bg-zinc-900 px-4 py-2 text-sm text-white placeholder:text-zinc-500 focus:border-zinc-500 focus:outline-none"
				/>
			</label>
		</header>

		<section
			id="results"
			class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
		>
			{inicial.content.map((programa) => <ProgramaCard programa={programa} />)}
		</section>

		<nav
			id="pagination"
			class="mt-10 flex items-center justify-center gap-4"
			data-total-pages={inicial.page.totalPages}
			data-page={inicial.page.number}
		>
			<button id="prev" type="button" class="rounded-full border border-zinc-700 px-4 py-2 text-sm text-zinc-300 hover:border-zinc-500 disabled:opacity-30 disabled:pointer-events-none">
				Anterior
			</button>
			<span class="text-sm text-zinc-400" id="page-info">
				Página {inicial.page.number + 1} de {Math.max(1, inicial.page.totalPages)}
			</span>
			<button id="next" type="button" class="rounded-full border border-zinc-700 px-4 py-2 text-sm text-zinc-300 hover:border-zinc-500 disabled:opacity-30 disabled:pointer-events-none">
				Siguiente
			</button>
		</nav>
		) : (
		<section class="py-24 text-center">
			<h1 class="font-anton text-3xl uppercase tracking-wide text-white">Tipo de programa no encontrado</h1>
			<p class="mt-3 text-zinc-400">No existe un tipo de programa con el slug «{slug}».</p>
			<a href="/" class="mt-8 inline-block rounded-full border border-zinc-700 px-6 py-2 text-sm text-zinc-300 hover:border-zinc-500">
				Volver al inicio
			</a>
		</section>
		)}
	</main>
</Layout>

<script>
	(() => {
	const app = document.getElementById("app") as HTMLElement | null;
	const search = document.getElementById("search") as HTMLInputElement | null;
	const results = document.getElementById("results") as HTMLElement | null;
	const prev = document.getElementById("prev") as HTMLButtonElement | null;
	const next = document.getElementById("next") as HTMLButtonElement | null;
	const pageInfo = document.getElementById("page-info") as HTMLElement | null;
	const total = document.getElementById("total") as HTMLElement | null;
	const pagination = document.getElementById("pagination") as HTMLElement | null;

	if (!app || !search || !results || !prev || !next || !pageInfo || !total || !pagination) return;

	const slug = app.dataset.slug as string;
	const size = 10;
	let page = 0;
	let totalPages = Number(pagination.dataset.totalPages);
	let timer: ReturnType<typeof setTimeout> | undefined;

	const formatSoles = (valor: number | null | undefined) =>
		new Intl.NumberFormat("es-PE", { style: "currency", currency: "PEN" }).format(valor ?? 0);

	function renderCard(p: any) {
		return `
			<a href="/${slug}/${p.slug}" class="group flex flex-col overflow-hidden rounded-2xl bg-zinc-900 border border-zinc-800 hover:border-zinc-600 transition-colors">
				<img src="${p.imagen}" alt="${p.nombre}" class="h-44 w-full object-cover opacity-70 transition-opacity group-hover:opacity-90" loading="lazy" />
				<div class="flex flex-1 flex-col gap-3 p-5">
					<h3 class="text-lg font-semibold leading-snug text-white">${p.nombre}</h3>
					<p class="line-clamp-2 text-sm text-zinc-400">${p.objetivoGeneral ?? ""}</p>
				<div class="mt-auto flex flex-wrap items-center gap-2 pt-2 text-xs text-zinc-400">
					${p.modalidad?.nombre ? `<span class="rounded-full bg-zinc-800 px-3 py-1">${p.modalidad.nombre}</span>` : ""}
					${p.facultad?.nombre ? `<span class="rounded-full bg-zinc-800 px-3 py-1">${p.facultad.nombre}</span>` : ""}
				</div>
					<div class="flex items-center justify-between pt-2">
						<span class="text-sm font-semibold text-white">${formatSoles(p.costoMatricula)}<span class="font-normal text-zinc-500"> / matrícula</span></span>
						<span class="text-zinc-500 transition-transform group-hover:translate-x-1 group-hover:text-white">→</span>
					</div>
				</div>
			</a>`;
	}

	async function cargar(nuevaPagina: number) {
		const q = search.value.trim();
		const url = `/api/open/programas/tipo/${slug}?q=${encodeURIComponent(q)}&page=${nuevaPagina}&size=${size}`;
		const res = await fetch(url);
		if (!res.ok) return;
		const { data } = await res.json();
		page = data.page.number;
		totalPages = data.page.totalPages;
		results.innerHTML = data.content.map(renderCard).join("") ||
			`<p class="col-span-full py-16 text-center text-zinc-500">Sin resultados para “${q}”.</p>`;
		total.textContent = `${data.page.totalElements} programas`;
		pageInfo.textContent = `Página ${page + 1} de ${Math.max(1, totalPages)}`;
		prev.disabled = page === 0;
		next.disabled = page >= totalPages - 1;
	}

	search.addEventListener("input", () => {
		clearTimeout(timer);
		timer = setTimeout(() => cargar(0), 300);
	});
	prev.addEventListener("click", () => {
		if (page > 0) cargar(page - 1);
	});
	next.addEventListener("click", () => {
		if (page < totalPages - 1) cargar(page + 1);
	});
	})();
</script>
