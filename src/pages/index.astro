---
import Nav from "@/components/Nav.astro";
import TipoCard from "@/components/TipoCard.astro";
import { getTiposPrograma } from "@/lib/api";
import Layout from "@/layouts/Layout.astro";

const tipos = await getTiposPrograma();
---

<Layout>
	<Nav />
	<main class="mx-auto max-w-6xl px-4 py-16">
		<section class="py-12 text-center">
			<h1 class="font-anton text-4xl uppercase tracking-wide text-white sm:text-6xl">
				Estudios de Posgrado
			</h1>
			<p class="mx-auto mt-4 max-w-2xl text-zinc-400">
				Programas de maestría y doctorado con docencia de excelencia, investigación
				de vanguardia y compromiso con el desarrollo de la región.
			</p>
		</section>
		<section class="grid gap-6 sm:grid-cols-2">
			{tipos.map((tipo) => <TipoCard tipo={tipo} />)}
		</section>
	</main>
</Layout>
